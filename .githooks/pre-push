#!/bin/sh
set -eu

remote_name="${1:-}"
zero_sha="0000000000000000000000000000000000000000"

if [ "${remote_name}" != "upstream" ]; then
  exit 0
fi

would_expose_resume() {
  commit="$1"

  git diff-tree --no-commit-id --name-status -r "${commit}" -- |
    awk '
      {
        status = $1
        sub(/[0-9]+$/, "", status)

        if ((status == "A" || status == "M" || status == "T") && $2 == "resume.md") {
          found = 1
        }

        if ((status == "C" || status == "R") && $3 == "resume.md") {
          found = 1
        }
      }
      END {
        exit(found ? 0 : 1)
      }
    '
}

while read local_ref local_sha remote_ref remote_sha; do
  [ "${local_sha}" = "${zero_sha}" ] && continue

  if [ "${remote_sha}" = "${zero_sha}" ]; then
    commits=$(git rev-list "${local_sha}" --not --remotes=upstream)
  else
    commits=$(git rev-list "${remote_sha}..${local_sha}")
  fi

  for commit in ${commits}; do
    if would_expose_resume "${commit}"; then
      echo "Blocked: push to upstream contains changes to resume.md in commit ${commit}."
      echo "Keep resume.md local-only and push template/repo changes upstream instead."
      exit 1
    fi
  done
done
